# Copy to .env and fill in. .env is gitignored and must never be committed.

# Admin login for the owner's side of the app.
ADMIN_USER=shopowner
ADMIN_PASS=pick-a-strong-password

# Outgoing mail for decision notifications. Leave SMTP_HOST unset and the app
# still runs -- messages are composed and logged instead of delivered.
#
# Gmail needs an App Password (Google Account > Security > 2-Step Verification
# > App passwords), not your normal account password.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Craft Corner <you@example.com>
