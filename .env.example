# Copy to .env and fill in. .env is gitignored and must never be committed.

# Store-mode accounts live in the database with hashed passwords, seeded by
# seed.py. There is no shared admin password any more. Change the seeded demo
# credentials (or create your own accounts as the owner) before exposing this.

# Outgoing mail for decision notifications. Leave SMTP_HOST unset and the app
# still runs -- messages are composed and logged instead of delivered.
#
# Gmail needs an App Password (Google Account > Security > 2-Step Verification
# > App passwords), not your normal account password.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=The Craft Corner <you@example.com>

# The parent platform's shared secret for /api/parent/*. Unset means that
# integration is off (those routes answer 404). Generate one and put the same
# value into ShopCRM's "Child app" dialog for this branch.
#   PARENT_TOKEN=some-long-random-string
PARENT_TOKEN=
